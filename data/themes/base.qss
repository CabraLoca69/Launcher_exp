/* ============================================================
   CLauncher69 — plantilla de estilos (la comparten todos los temas)

   Los colores salen de la paleta del tema (data/themes/<tema>.json):
     @nombre      → color de la paleta
     @nombre/NN   → ese color con NN % de opacidad (0-100)
   Lo procesa interface_files/themes.py.
   ============================================================ */

/* ── Reset base ──────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    color: @text;
    outline: none;
    border: none;
}

QMainWindow, QWidget {
    background-color: @bg;
    color: @text;
}

/* ── Header ──────────────────────────────────────────────────── */
QWidget#header {
    background-color: @surface;
    border-bottom: 1px solid @accent/19;
    min-height: 44px;
}

QWidget#header QLabel {
    color: @text_muted;
    font-size: 12px;
}

QLabel#emptyState {
    color: @text_muted;
    font-size: 18px;
}

/* ── Botones generales ───────────────────────────────────────── */
QPushButton {
    background-color: transparent;
    color: @accent;
    border: 1px solid @accent/25;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 12px;
    letter-spacing: 0.5px;
}

QPushButton:hover {
    background-color: @accent/8;
    border-color: @accent/50;
    color: @text_bright;
}

QPushButton:pressed {
    background-color: @accent/15;
    border-color: @accent;
}

QPushButton:disabled {
    color: @text_faint;
    border-color: @border;
}

/* ── Botón play principal ────────────────────────────────────── */
QPushButton#btnPlay {
    background-color: @accent/9;
    color: @accent;
    border: 1px solid @accent/38;
    border-radius: 4px;
    font-weight: bold;
    font-size: 12px;
    padding: 5px 0;
}

QPushButton#btnPlay:hover {
    background-color: @accent/19;
    border-color: @accent;
    color: @text_bright;
}

QPushButton#btnPlay:pressed {
    background-color: @accent/27;
}

/* ── Botones ícono (★ ⋯ ⚙) ───────────────────────────────────── */
QPushButton#btnIconAction {
    background-color: transparent;
    color: @text_dim;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px;
    font-size: 14px;
}

QPushButton#btnIconAction:hover {
    background-color: @accent2/8;
    border-color: @accent2/38;
    color: @accent2;
}

QPushButton#btnIconAction:pressed {
    background-color: @accent2/19;
    color: @accent2;
}

/* ── Botón play pequeño (favoritos) ─────────────────────────── */
QPushButton#btnPlaySmall {
    background-color: transparent;
    color: @accent/38;
    border: 1px solid @accent/15;
    border-radius: 3px;
    font-size: 11px;
    padding: 2px;
}

QPushButton#btnPlaySmall:hover {
    background-color: @accent/9;
    color: @accent;
    border-color: @accent/44;
}

/* ── Tabs ────────────────────────────────────────────────────── */
QTabWidget::pane {
    background-color: @bg;
    border: 1px solid @accent/13;
    border-top: none;
}

QTabBar {
    background-color: @surface;
}

QTabBar::tab {
    background-color: transparent;
    color: @text_muted;
    padding: 8px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
    letter-spacing: 0.3px;
    min-width: 100px;
}

QTabBar::tab:selected {
    color: @accent;
    border-bottom: 2px solid @accent;
    background-color: @accent/3;
}

QTabBar::tab:hover:!selected {
    color: @text_soft;
    background-color: @text/2;
}

/* ── Sidebar ─────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: @sidebar;
    border-right: 1px solid @accent/9;
}

/* ── Campos de texto ─────────────────────────────────────────── */
QLineEdit, QPlainTextEdit {
    background-color: @surface_alt;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: @accent/19;
    selection-color: @text_bright;
}

QLineEdit:focus, QPlainTextEdit:focus {
    border-color: @accent/31;
}

QLineEdit:hover, QPlainTextEdit:hover {
    border-color: @accent/19;
}

/* ── Árbol de juegos ─────────────────────────────────────────── */
QTreeWidget {
    background-color: transparent;
    color: @text_soft;
    border: none;
    show-decoration-selected: 0;
}

QTreeWidget::item {
    padding: 5px 8px;
    border: none;
    border-left: 2px solid transparent;
}

QTreeWidget::item:hover {
    background-color: @accent/5;
    color: @text;
}

/* Seleccionado: solo una línea al costado */
QTreeWidget::item:selected {
    background-color: transparent;
    color: @accent;
    border-left: 2px solid @accent;
}

QTreeWidget::item:selected:hover {
    background-color: @accent/5;
}

QTreeWidget::branch,
QTreeWidget::branch:selected {
    background-color: transparent;
}

QHeaderView::section {
    background-color: @surface;
    color: @text_dim;
    border: none;
    border-bottom: 1px solid @border;
    padding: 6px 8px;
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* ── Listas (directorios en Propiedades) ─────────────────────── */
QListWidget {
    background-color: @surface;
    color: @text_soft;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px;
}

QListWidget::item {
    padding: 5px 8px;
    border-left: 2px solid transparent;
}

QListWidget::item:hover {
    background-color: @accent/5;
}

QListWidget::item:selected {
    background-color: transparent;
    color: @accent;
    border-left: 2px solid @accent;
}

/* ── Panel detalle (derecha) ─────────────────────────────────── */
QWidget#gameDetailPanel {
    background-color: @bg;
}

QWidget#detailTopBar {
    background-color: @surface;
    border-bottom: 1px solid @accent/8;
    min-height: 48px;
}

QLabel#gameNameLabel {
    color: @text_bright;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.3px;
}

QFrame#detailSeparator {
    background-color: @accent/9;
    max-height: 1px;
    border: none;
}

QLabel#sectionTitle {
    color: @text_dim;
    font-size: 11px;
    letter-spacing: 0.8px;
}

/* ── Filas de sesión ─────────────────────────────────────────── */
QWidget#sessionRow {
    background-color: transparent;
    border-radius: 3px;
}

QWidget#sessionRow:hover {
    background-color: @accent/3;
}

QLabel#sessionDate {
    color: @text_muted;
    font-size: 12px;
}

QLabel#sessionDuration {
    color: @accent/50;
    font-size: 12px;
    font-weight: bold;
}

/* ── SessionsBar (sesiones en vivo) ──────────────────────────── */
QFrame#sessionBarFrame {
    background-color: @surface;
    border: 1px solid @accent/13;
    border-radius: 4px;
}

QLabel#sessionBarName {
    color: @text;
    font-size: 12px;
    font-weight: bold;
}

QLabel#sessionBarTime {
    color: @accent;
    font-size: 12px;
}

QPushButton#btnCloseSession {
    background-color: @accent2/9;
    color: @accent2;
    border: 1px solid @accent2/31;
    border-radius: 4px;
    padding: 4px;
    font-size: 12px;
}

QPushButton#btnCloseSession:hover {
    background-color: @accent2/19;
    border-color: @accent2;
    color: @text_bright;
}

/* ── Panel favoritos ─────────────────────────────────────────── */
QWidget#favoritesPanel {
    background-color: @bg;
}

QLabel#favoritesPanelTitle {
    color: @accent2;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.5px;
    padding-bottom: 8px;
    border-bottom: 1px solid @accent2/15;
    margin-bottom: 4px;
}

QWidget#favoriteRow {
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 4px;
}

QWidget#favoriteRow:hover {
    background-color: @surface_alt;
    border-color: @accent2/25;
}

QLabel#favoriteGameName {
    color: @text_soft;
    font-size: 12px;
}

QLabel#favoriteGameHours {
    color: @accent/50;
    font-size: 11px;
    font-weight: bold;
}

/* ── Hint vacío ──────────────────────────────────────────────── */
QLabel#emptyHint {
    color: @text_faint;
    font-size: 12px;
    font-style: italic;
}

/* ── Scroll bars ─────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: @border;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: @accent/19;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: @border;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @accent/19;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ── Popups / Diálogos ───────────────────────────────────────── */
QDialog {
    background-color: @surface_alt;
    border: 1px solid @accent/19;
    border-radius: 6px;
}

QDialog QWidget {
    background-color: @surface_alt;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @accent/38;
    border-radius: 3px;
    background-color: transparent;
}

QCheckBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}

QComboBox {
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 5px 10px;
}

QComboBox:hover {
    border-color: @accent/31;
}

QComboBox QAbstractItemView {
    background-color: @surface;
    color: @text;
    border: 1px solid @accent/19;
    selection-background-color: @accent/13;
    selection-color: @accent;
}

QLabel#inputDialogPrompt {
    color: @text_soft;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.3px;
}

QLabel#confirmDialogTitle {
    color: @text_bright;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.3px;
}

QLabel#confirmDialogMessage {
    color: @text_soft;
    font-size: 12px;
}

/* ── Botones de acción en diálogos y menús ───────────────────── */
QPushButton#btnSuccess {
    background-color: @accent/9;
    color: @accent;
    border: 1px solid @accent/31;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}

QPushButton#btnSuccess:hover {
    background-color: @accent/19;
    border-color: @accent;
    color: @text_bright;
}

QPushButton#btnDanger {
    background-color: @accent2/9;
    color: @accent2;
    border: 1px solid @accent2/31;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}

QPushButton#btnDanger:hover {
    background-color: @accent2/19;
    border-color: @accent2;
    color: @text_bright;
}

/* ── Menú contextual flotante ────────────────────────────────── */
QDialog#customPopupMenu {
    background-color: @surface_alt;
    border: 1px solid @accent/19;
    border-radius: 5px;
    padding: 2px;
}

QDialog#customPopupMenu QPushButton {
    background-color: transparent;
    color: @text_soft;
    border: none;
    border-radius: 3px;
    padding: 7px 14px;
    text-align: left;
    font-size: 12px;
}

QDialog#customPopupMenu QPushButton:hover {
    background-color: @accent/7;
    color: @accent;
}

QDialog#customPopupMenu QPushButton#btnSuccess {
    color: @accent;
}

QDialog#customPopupMenu QPushButton#btnDanger {
    color: @accent2;
}

QDialog#customPopupMenu QPushButton#btnWarning {
    color: @warning;
}

/* ── Tooltip ─────────────────────────────────────────────────── */
QToolTip {
    background-color: @surface_alt;
    color: @text;
    border: 1px solid @accent/19;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 11px;
}
